{
    "family": "skyvoice-backend",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "512",
    "memory": "1024",
    "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/skyvoiceTaskRole",
    "containerDefinitions": [
        {
            "name": "skyvoice-backend",
            "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/skyvoice-backend:latest",
            "portMappings": [
                {
                    "containerPort": 5004,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                { "name": "NODE_ENV", "value": "production" },
                { "name": "PORT",     "value": "5004" }
            ],
            "secrets": [
                { "name": "AWS_ACCESS_KEY_ID",          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:skyvoice/aws-key" },
                { "name": "AWS_SECRET_ACCESS_KEY",       "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:skyvoice/aws-secret" },
                { "name": "SUPABASE_URL",                "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:skyvoice/supabase-url" },
                { "name": "SUPABASE_SERVICE_ROLE_KEY",   "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:skyvoice/supabase-key" }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/skyvoice-backend",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "healthCheck": {
                "command": ["CMD-SHELL", "wget -qO- http://localhost:5004/health || exit 1"],
                "interval": 30,
                "timeout": 5,
                "retries": 3
            }
        }
    ]
}